<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Convertitore CodeWalker XML -> binario RAGE (.ydr/.yft/.ydd/.ytd/.ybn/.ycd/.ytyp/.ymap ...)
    Usa CodeWalker.Core (https://github.com/dexyfex/CodeWalker), stessa logica di "Import XML" in RPF Explorer.
    Build:  git clone https://github.com/dexyfex/CodeWalker ../CodeWalker   (oppure passa -p:CodeWalkerDir=...)
            dotnet build -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <CodeWalkerDir Condition="'$(CodeWalkerDir)' == ''">$(MSBuildThisFileDirectory)../CodeWalker</CodeWalkerDir>
    <NoWarn>$(NoWarn);CS0618;NU1701</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CodeWalkerDir)/CodeWalker.Core/CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
