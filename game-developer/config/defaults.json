{
  "version": 1,
  "paths": {
    "voxelai": "",
    "designerSkill": "",
    "terminalmcp": "",
    "blender": "",
    "unityCli": "",
    "unreal": ""
  },
  "engines": {
    "default": "unity",
    "realistic": "unreal",
    "unrealMin": "5.8"
  },
  "modules": {
    "skillFiles": true,
    "commands": true,
    "unityCli": true,
    "unityOfficialSkills": true,
    "blenderMcp": true,
    "voxelMcp": true,
    "terminalMcp": true,
    "designSkill": true,
    "gdsEditor": true
  },
  "mcp": {
    "blenderCommand": [
      "cmd",
      "/c",
      "uvx",
      "mcp-for-blender"
    ],
    "blenderEnv": {
      "BLENDER_HOST": "localhost",
      "BLENDER_PORT": "9876"
    },
    "voxelaiWorkdirMode": "per-project",
    "terminalHttp": false
  },
  "unity": {
    "templatePreference": [
      "com.unity.template.urp-blank",
      "com.unity.template.universal-2d"
    ],
    "coplayGitUrl": "https://github.com/CoplayDev/unity-mcp.git?path=/MCPForUnity",
    "packages": [
      "com.unity.inputsystem",
      "com.unity.cinemachine",
      "com.unity.textmeshpro",
      "com.unity.ugui",
      "com.unity.render-pipelines.universal",
      "com.unity.test-framework",
      "com.unity.probuilder",
      "com.unity.pipeline"
    ],
    "recommendedEditors": [
      "6000.5",
      "6000.3",
      "6000.0"
    ],
    "gdsEditorTemplates": "templates/Editor/GDS",
    "optionalRenderingPackages": {
      "toon": "https://github.com/Delt06/urp-toon-shader.git?path=Packages/com.deltation.toon-shader",
      "outline": "https://github.com/CristianQiu/Unity-URP-Outline.git",
      "volumetric": "https://github.com/CristianQiu/Unity-URP-Volumetric-Light.git"
    },
    "gdsRuntimeTemplates": "templates/Runtime/GDS"
  },
  "art": {
    "scale": "1u=1m",
    "forbidPaid3dApis": false,
    "forbidSloydDefault": true,
    "preferKits": [
      "kenney",
      "kaykit",
      "quaternius-standard",
      "synty-starter"
    ],
    "forbidBpyModelling": true,
    "polyhavenUserAgent": "GameDeveloperSkill/1.0",
    "gen3dTiers": [
      "none",
      "local",
      "meshy",
      "tripo",
      "hyper3d"
    ],
    "gen3dDefault": "none",
    "gen3dMaxAssetsDefault": 5,
    "assetStoreDefault": "ask",
    "forbidHdriOnPropMaterials": true,
    "forbidWallByWallPlacement": true,
    "lookdevPresets": [
      "stylized-day",
      "stylized-sunset",
      "dungeon-torch",
      "night-moon",
      "pastel-bright",
      "scifi-cold",
      "toon-bright",
      "realistic-overcast",
      "realistic-golden"
    ],
    "lookdevDefault": "stylized-day",
    "styles": [
      "lowpoly",
      "toon",
      "stylized",
      "voxel",
      "realistic",
      "2d-pixel"
    ]
  },
  "bridge": {
    "unity": "cli",
    "unityFallback": "coplay-mcp",
    "unreal": "unreal-mcp-5.8"
  },
  "fab": {
    "enabled": false,
    "cli": "",
    "library_path": ""
  },
  "tasks": {
    "target": "60-80",
    "max": 90
  }
}
